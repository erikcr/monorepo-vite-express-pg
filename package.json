{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter='./artifacts/*' build",
    "codegen": "pnpm --filter @repo/api-spec codegen",
    "codegen:check": "pnpm codegen && git diff --exit-code lib/api-zod/src/index.ts lib/api-client-react/src/index.ts",
    "dev": "pnpm --parallel --filter='./artifacts/*' dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:check": "pnpm db:generate && git diff --exit-code lib/db/migrations",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "pnpm --filter @repo/db studio",
    "test": "pnpm -r test",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm codegen:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "simple-git-hooks": "^2.11.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
