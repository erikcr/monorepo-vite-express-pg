{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    // CI runs these files with Node directly (type stripping), which needs real .ts imports.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
