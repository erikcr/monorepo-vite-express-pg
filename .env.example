DATABASE_URL=postgres://postgres:postgres@localhost:5432/appdb
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
# The web site's URL, for links in emails (invitations). Default: http://localhost:5173 (not in production).
# WEB_URL=http://localhost:5173
# Run the job worker inside the API process (default). Set false to run dist/worker.js separately.
# RUN_WORKER=false
# Rate limit per client IP (default 300 requests per 60000 ms; 0 disables).
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
# Serve the API reference at /docs (default: on, except in production).
# API_DOCS=true
# Clerk (identity). Server secret from the Clerk dashboard → API keys; dev instance locally.
# CLERK_SECRET_KEY=sk_test_...
# Clerk publishable key for the web and admin apps (same Clerk instance as the secret key).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Where to report a vulnerability, served by both sites at /.well-known/security.txt (production
# builds). Unset: no security.txt. A mailto: or https: URL.
# VITE_SECURITY_CONTACT=mailto:security@example.com
# Sentry (error tracking). Unset: errors are only logged. Usually left unset locally.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Email through Resend (resend.com). Unset: emails are logged instead of sent. EMAIL_FROM must be on
# a domain verified in Resend; unset, Resend's test sender only delivers to your own Resend address.
# RESEND_API_KEY=re_...
# EMAIL_FROM=App <hello@example.com>
# Webhook signing secrets (Resend: Webhooks; Clerk: Webhooks). Only needed where the provider can reach the API.
# RESEND_WEBHOOK_SECRET=whsec_...
# CLERK_WEBHOOK_SECRET=whsec_...
