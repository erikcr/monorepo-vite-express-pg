DATABASE_URL=postgres://postgres:postgres@localhost:5432/appdb
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
# Run the job worker inside the API process (default). Set false to run dist/worker.js separately.
# RUN_WORKER=false
# Rate limit per client IP (default 300 requests per 60000 ms; 0 disables).
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
