{
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @repo/admin build",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": { "deploymentEnabled": { "main": false, "staging": false } },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
